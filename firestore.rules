rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorized() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in team();
    }
    function team() {
      return [
        'valeryalarconra@gmail.com',
        'acariaaas.07@gmail.com',
        'daniel1ajedrez@gmail.com',
        'yury.alexander2005@gmail.com',
        'fatimacerezo2411@gmail.com',
        'devjorgemejia@gmail.com',
        'estebantrampej@gmail.com'
      ];
    }

    function reference(kind, id) {
      return /databases/$(database)/documents/$(kind)/$(id);
    }
    function parentAvailable(kind, id) {
      return id == '' || (existsAfter(reference(kind, id)) && getAfter(reference(kind, id)).data.archived == false);
    }
    function fields(names) {
      let all = names.concat(['revision', 'archived', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy']);
      return request.resource.data.keys().hasAll(all) && request.resource.data.keys().hasOnly(all);
    }
    function metadata() {
      let d = request.resource.data;
      return d.revision is int && d.revision > 0 && d.archived is bool
        && d.createdAt is string && d.updatedAt is string
        && d.createdBy is string && d.updatedBy == request.auth.token.email.lower()
        && d.updatedAt.size() <= 40 && d.createdAt.size() <= 40;
    }
    function color(value) { return value in ['blue', 'violet', 'green', 'amber', 'coral']; }
    function label(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validComments() {
      let list = request.resource.data.comments;
      return request.method == 'create' ? list.size() == 0 : (
        list == resource.data.comments || (list.size() == resource.data.comments.size() + 1
          && list[list.size() - 1].keys().hasAll(['id', 'body', 'author', 'createdAt'])
          && label(list[list.size() - 1].id, 80)
          && label(list[list.size() - 1].body, 3000)
          && list[list.size() - 1].author == request.auth.token.email.lower()
          && list[list.size() - 1].createdAt is string
          && list.removeAll([list[list.size() - 1]]) == resource.data.comments)
      );
    }
    // Lista de respuestas: solo se añade una al final, firmada por quien escribe.
    function appendedBy(next, previous, maxBody) {
      return request.method == 'create' ? next.size() == 0 : (
        next == previous || (next.size() == previous.size() + 1
          && next[next.size() - 1].keys().hasAll(['id', 'body', 'author', 'createdAt'])
          && next[next.size() - 1].keys().hasOnly(['id', 'body', 'author', 'createdAt'])
          && label(next[next.size() - 1].id, 80)
          && label(next[next.size() - 1].body, maxBody)
          && next[next.size() - 1].author == request.auth.token.email.lower()
          && next[next.size() - 1].createdAt is string
          && next.removeAll([next[next.size() - 1]]) == previous)
      );
    }
    // Votos: cada persona solo añade o quita su propio correo.
    function ownVote(next, previous) {
      let me = request.auth.token.email.lower();
      return request.method == 'create' ? next.size() == 0 : (
        next == previous
        || (!(me in previous) && next == previous.concat([me]))
        || (me in previous && next == previous.removeAll([me]))
      );
    }
    function financePayments() {
      let next = request.resource.data.paidDates;
      return request.method == 'create' ? next.size() == 0 : (
        next == resource.data.paidDates || (
          next.size() == resource.data.paidDates.size() + 1 && next.removeAll(resource.data.paidDates).size() == 1
          && resource.data.paidDates.removeAll(next).size() == 0
          && next.removeAll(resource.data.paidDates)[0] is string
          && next.removeAll(resource.data.paidDates)[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && next.removeAll(resource.data.paidDates)[0] >= request.resource.data.date
          && (request.resource.data.endDate == '' || next.removeAll(resource.data.paidDates)[0] <= request.resource.data.endDate)
        ) || (next.size() == resource.data.paidDates.size() - 1 && next.removeAll(resource.data.paidDates).size() == 0)
      );
    }
    function shape(kind, id) {
      let d = request.resource.data;
      return metadata() && (
        (kind == 'financeEntries' && (fields(['title', 'kind', 'amount', 'currency', 'date', 'frequency', 'endDate', 'category', 'notes', 'paidDates'])
            // Gastos de equipo: entre quiénes se reparte, quién pagó cada fecha y quiénes ya devolvieron su parte.
            || (fields(['title', 'kind', 'amount', 'currency', 'date', 'frequency', 'endDate', 'category', 'notes', 'paidDates', 'members', 'payers', 'settled'])
              && d.members is list && d.members.size() <= 7 && d.members.toSet().size() == d.members.size() && d.members.hasOnly(team())
              && (d.members.size() == 0 || (d.kind == 'expense' && d.members.size() >= 2))
              && d.payers is map && d.payers.size() <= 1200 && d.settled is map && d.settled.size() <= 1200))
          && label(d.title, 200) && d.kind in ['expense', 'income'] && d.amount is int && d.amount > 0 && d.amount <= 100000000000
          && d.currency in ['USD', 'GTQ'] && label(d.date, 10) && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.date >= '1900-01-01' && d.date <= '2200-12-31'
          && d.frequency in ['once', 'monthly', 'yearly'] && d.endDate is string && (d.endDate == '' || (d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.endDate >= d.date && d.endDate <= '2200-12-31'))
          && label(d.category, 60) && d.notes is string && d.notes.size() <= 3000 && d.paidDates is list && d.paidDates.size() <= 1200 && d.paidDates.toSet().size() == d.paidDates.size() && financePayments()
          && (request.method == 'create' ? d.paidDates.size() == 0 : (resource.data.paidDates.size() == 0 || !d.diff(resource.data).affectedKeys().hasAny(['amount', 'currency', 'kind', 'date', 'frequency']))))
        || (kind == 'meetings' && fields(['eventId', 'agenda', 'notes', 'transcript', 'recordingUrl'])
          && d.eventId == id && d.agenda is list && d.agenda.size() <= 40
          && d.notes is string && d.notes.size() <= 20000 && d.transcript is string && d.transcript.size() <= 200000
          && d.recordingUrl is string && d.recordingUrl.size() <= 500 && (d.recordingUrl == '' || d.recordingUrl.matches('^https://[^ ]+$'))
          && (d.archived || parentAvailable('events', d.eventId)))
        || (kind == 'meetingQuestions' && fields(['eventId', 'body', 'answers', 'votes', 'resolved'])
          && label(d.eventId, 80) && label(d.body, 2000) && d.resolved is bool
          && d.answers is list && d.answers.size() <= 100 && d.votes is list && d.votes.size() <= 7 && d.votes.hasOnly(team())
          && appendedBy(d.answers, request.method == 'create' ? [] : resource.data.answers, 3000)
          && ownVote(d.votes, request.method == 'create' ? [] : resource.data.votes)
          // Solo quien preguntó cambia el texto; la reunión no cambia.
          && (request.method == 'create' || ((d.body == resource.data.body || resource.data.createdBy == request.auth.token.email.lower()) && d.eventId == resource.data.eventId))
          && (d.archived || parentAvailable('events', d.eventId)))
        || (kind == 'workspaceGuards' && fields(['parentKind', 'parentId'])
          && d.parentKind in ['boards', 'calendars', 'folders', 'whiteboards'] && label(d.parentId, 80))
        || (kind == 'boards' && (fields(['name', 'description', 'color', 'columns', 'columnOrder']) || fields(['name', 'description', 'color', 'columns', 'columnOrder', 'position']))
          && (!('position' in d) || (d.position is int && d.position >= 1 && d.position <= 99))
          && label(d.name, 120) && d.description is string && d.description.size() <= 3000 && color(d.color)
          && d.columns is map && d.columnOrder is list && d.columnOrder.size() >= 1 && d.columnOrder.size() <= 12
          && d.columnOrder.toSet().size() == d.columnOrder.size()
          && d.columns.keys().hasAll(d.columnOrder) && d.columnOrder.hasOnly(d.columns.keys()))
        || (kind == 'whiteboards' && fields(['name', 'description', 'color'])
          && label(d.name, 120) && d.description is string && d.description.size() <= 3000 && color(d.color))
        || (kind == 'stickyNotes' && (fields(['whiteboardId', 'text', 'color', 'x', 'y']) || ((fields(['whiteboardId', 'text', 'color', 'x', 'y', 'kind', 'w', 'h', 'points', 'size'])
              || (fields(['whiteboardId', 'text', 'color', 'x', 'y', 'kind', 'w', 'h', 'points', 'size', 'from', 'to']) && d.from is string && d.from.size() <= 80 && d.to is string && d.to.size() <= 80)
              || (fields(['whiteboardId', 'text', 'color', 'x', 'y', 'kind', 'w', 'h', 'points', 'size', 'from', 'to', 'style']) && d.from is string && d.from.size() <= 80 && d.to is string && d.to.size() <= 80
                && d.style is map && d.style.keys().hasOnly(['arrowType', 'head', 'stroke', 'weight', 'fill', 'font', 'align', 'z'])
                && d.style.get('arrowType', 'straight') in ['straight', 'elbow', 'curved'] && d.style.get('head', 'end') in ['none', 'end', 'start', 'both']
                && d.style.get('stroke', 'solid') in ['solid', 'dashed', 'dotted'] && d.style.get('weight', 2) in [1, 2, 4]
                && d.style.get('fill', 'none') in ['none', 'soft', 'solid'] && d.style.get('font', 'sans') in ['sans', 'display', 'mono', 'serif']
                && d.style.get('align', 'left') in ['left', 'center', 'right'] && d.style.get('z', 0) is int))
            && d.kind in ['note', 'text', 'pen', 'rect', 'ellipse', 'arrow'] && d.size in ['sm', 'md', 'lg', 'xl']
            && d.w is int && d.w >= 0 && d.w <= 4000 && d.h is int && d.h >= 0 && d.h <= 4000
            && d.points is list && d.points.size() <= 1000))
          && d.whiteboardId is string && d.whiteboardId != '' && d.text is string && d.text.size() <= 500
          && d.color in ['yellow', 'pink', 'blue', 'green', 'violet', 'ink', 'coral', 'amber']
          && d.x is int && d.x >= 0 && d.x <= 4000 && d.y is int && d.y >= 0 && d.y <= 4000
          && (d.archived || parentAvailable('whiteboards', d.whiteboardId)))
        || (kind == 'calendars' && fields(['name', 'description', 'color'])
          && label(d.name, 120) && d.description is string && d.description.size() <= 3000 && color(d.color))
        || (kind == 'folders' && fields(['name', 'parentId', 'color'])
          && label(d.name, 120) && color(d.color) && d.parentId is string && d.parentId != id
          && (d.archived || parentAvailable('folders', d.parentId)))
        || (kind == 'wikiPages' && fields(['title', 'description', 'folderId', 'tags'])
          && label(d.title, 200) && d.description is string && d.description.size() <= 3000 && d.folderId is string
          && d.tags is list && d.tags.size() <= 12 && (d.archived || parentAvailable('folders', d.folderId)))
        || (kind == 'wikiContent' && fields(['body']) && label(d.body, 100000)
          && existsAfter(reference('wikiPages', id)) && d.revision == getAfter(reference('wikiPages', id)).data.revision)
        || (kind == 'tasks' && (fields(['title', 'description', 'boardId', 'status', 'priority', 'type', 'assignee', 'dueDate', 'tags', 'points', 'articleId', 'checklist', 'comments']) || fields(['title', 'description', 'boardId', 'status', 'priority', 'type', 'assignee', 'dueDate', 'tags', 'points', 'articleId', 'checklist', 'comments', 'rank']))
          && (!('rank' in d) || d.rank is number)
          && label(d.title, 200) && d.description is string && d.description.size() <= 12000
          && d.boardId is string && d.boardId != '' && d.status is string
          && d.priority in ['high', 'medium', 'low'] && d.type in ['task', 'bug', 'story', 'epic']
          && d.assignee is string && d.dueDate is string && d.dueDate.size() <= 10
          && d.tags is list && d.tags.size() <= 12 && d.checklist is list && d.checklist.size() <= 30
          && d.comments is list && d.comments.size() <= 100 && validComments() && d.points is int && d.points >= 0 && d.points <= 100
          && d.articleId is string
          && (d.archived || (parentAvailable('boards', d.boardId)
            && d.status in getAfter(reference('boards', d.boardId)).data.columnOrder
            && parentAvailable('wikiPages', d.articleId))))
        || (kind == 'events' && (fields(['title', 'description', 'calendarId', 'allDay', 'start', 'end', 'location', 'articleId']) || fields(['title', 'description', 'calendarId', 'allDay', 'start', 'end', 'location', 'articleId', 'meetUrl'])
            || (fields(['title', 'description', 'calendarId', 'allDay', 'start', 'end', 'location', 'articleId', 'meetUrl', 'meeting']) && d.meeting is bool)
            // Copia en Google Calendar: ID del evento de Google, su enlace, quién lo creó y la revisión enviada.
            || (fields(['title', 'description', 'calendarId', 'allDay', 'start', 'end', 'location', 'articleId', 'meetUrl', 'meeting', 'google']) && d.meeting is bool
              && d.google is map && d.google.keys().hasAll(['id', 'url', 'owner', 'revision']) && d.google.keys().hasOnly(['id', 'url', 'owner', 'revision'])
              && d.google.id is string && d.google.id.size() >= 5 && d.google.id.size() <= 1024 && d.google.id.matches('^[a-v0-9]+$')
              && d.google.url is string && d.google.url.size() <= 2000 && d.google.url.matches('^https://www[.]google[.]com/calendar/[^ ]*$')
              && d.google.owner in team() && d.google.revision is int))
          && (!('meetUrl' in d) || (d.meetUrl is string && d.meetUrl.size() <= 500 && (d.meetUrl == '' || d.meetUrl.matches('^https://meet[.]google[.]com/([a-zA-Z0-9-]+|lookup/[a-zA-Z0-9_-]+)/?([?][^# ]*)?(#[^ ]*)?$'))))
          && label(d.title, 200) && d.description is string && d.description.size() <= 12000
          && d.calendarId is string && d.calendarId != '' && d.allDay is bool
          && label(d.start, 40) && label(d.end, 40) && d.start != d.end
          && d.location is string && d.location.size() <= 500 && d.articleId is string
          && (d.archived || (parentAvailable('calendars', d.calendarId) && parentAvailable('wikiPages', d.articleId))))
      );
    }
    match /{collection}/{document} {
      allow read: if collection in ['boards', 'tasks', 'calendars', 'events', 'folders', 'wikiPages', 'whiteboards', 'stickyNotes', 'wikiContent', 'workspaceGuards', 'financeEntries', 'meetings', 'meetingQuestions'] && authorized();
      allow create: if authorized() && shape(collection, document)
        && request.resource.data.revision == 1 && request.resource.data.archived == false
        && request.resource.data.createdBy == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if authorized() && shape(collection, document)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (collection == 'wikiContent' ? request.resource.data.revision > resource.data.revision : request.resource.data.revision == resource.data.revision + 1);
      // Borrado permanente solo de tareas, eventos y post-its; lo demás se archiva.
      allow delete: if authorized() && collection in ['tasks', 'events', 'stickyNotes'];
    }
  }
}
